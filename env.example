# Smart AI Chatbot Environment Configuration
# Copy this file to .env and update the values as needed

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False
FLASK_ENV=production

# Database Configuration
DATABASE_URL=sqlite:///chatbot.db
# For PostgreSQL: postgresql://username:password@localhost/chatbot_db

# AI/ML Model Configuration
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
GENERATIVE_MODEL=microsoft/DialoGPT-medium
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# FAISS Configuration
FAISS_INDEX_PATH=models/faiss_index
FAISS_DIMENSION=384
FAISS_NPROBE=10

# Language Processing
TRANSLATION_SERVICE=google
# Options: google, deep_translator, custom

# Training Configuration
TRAINING_DATA_PATH=data/training
MODEL_SAVE_PATH=models
MIN_CONFIDENCE_THRESHOLD=0.7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
CACHE_TTL=3600

# Security Configuration
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Feedback Configuration
FEEDBACK_ENABLED=True
MIN_FEEDBACK_RATING=4
FEEDBACK_COOLDOWN=300

# Training Pipeline Configuration
TRAINING_SCHEDULE=weekly
MIN_TRAINING_SAMPLES=100
MODEL_EVALUATION_THRESHOLD=0.8

# Knowledge Base Configuration
KNOWLEDGE_BASE_PATH=data/knowledge_base
MAX_KNOWLEDGE_ENTRIES=10000
KNOWLEDGE_UPDATE_INTERVAL=86400

# Embedding Cache Configuration
EMBEDDING_CACHE_ENABLED=True
EMBEDDING_CACHE_SIZE=10000
EMBEDDING_CACHE_TTL=86400

# External API Keys (if needed)
# GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
# OPENAI_API_KEY=your-openai-api-key

# Production Settings
# PORT=5000
# HOST=0.0.0.0 