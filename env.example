# Career Copilot environment template
# Copy to .env and replace development values as needed.
# Never commit .env or real credentials.

# Flask and sessions
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
FLASK_ENV=development
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Database
DATABASE_URL=sqlite:///career_copilot.db
# Production example:
# DATABASE_URL=postgresql://username:password@host:5432/career_copilot

# Application URLs
APP_BASE_URL=http://localhost:5000
PORT=5000
HOST=127.0.0.1

# Optional SMTP password-reset delivery
# Without these values, reset links are logged for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# Optional Google OAuth 2.0
# Register this local redirect URI in Google Cloud Console:
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# CORS. Keep local development restrictive when possible.
CORS_ORIGINS=http://localhost:5000
